# Copy to .env locally; never commit secrets.
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://terminal.local:4173
JWT_SECRET=replace-with-at-least-32-random-characters
# Production requires managed PostgreSQL. Omit locally to use persistent PGlite.
# DATABASE_URL=postgresql://urfa:password@localhost:5432/urfa
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=Urfa Grill <orders@example.com>
VITE_API_URL=/api
VITE_DEMO_MODE=false
# Optional SMS reminders, only for customers who explicitly opt in:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
